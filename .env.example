# ============================================================
# Variables compartidas por los microservicios (copiar a .env)
# ============================================================
# Firma de JWT — DEBE ser idéntica en todos los servicios y el gateway
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=7d
NODE_ENV=development

# URL pública del Gateway (lo que apunta VITE_API_URL en el frontend)
GATEWAY_PORT=3000

# Supabase PostgreSQL (misma URL para todos los servicios; cada uno usa su schema)
# Usa el pooler de Supabase (puerto 6543) para la app en runtime.
SUPABASE_DATABASE_URL=postgresql://postgres.ktmsemzpnpvlcyxjtqlf:Elemet1337_@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Schemas por servicio (ya vienen con valores por defecto en docker-compose.yml)
AUTH_DATABASE_SCHEMA=element_auth
QUOTES_DATABASE_SCHEMA=quotes
PAYMENTS_DATABASE_SCHEMA=payments
CONFIG_DATABASE_SCHEMA=config
CATALOG_DATABASE_SCHEMA=catalog
PUBLIC_DATABASE_SCHEMA=site
TILE_CALCULATOR_DATABASE_SCHEMA=tile_calculator
